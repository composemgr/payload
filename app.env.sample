# Payload CMS environment configuration
# Copy to app.env and adjust values as needed

# Timezone
TZ=America/New_York

# Application secret (min 32 chars)
APP_SECRET_KEY=replace-with-a-random-secret-key-min-32-chars

# Database (MongoDB)
DB_ADMIN_NAME=root
DB_ADMIN_PASS=replace-with-a-random-password
DB_CREATE_DATABASE_NAME=payload
